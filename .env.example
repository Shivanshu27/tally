# Copy to .env and edit. `.env` is git-ignored.
#
# Every value below is a local-development default. The application refuses to
# start with the default Postgres password when TALLY_ENV is anything other
# than "development" or "test", so a deployment cannot inherit it by omission.

TALLY_ENV=development
TALLY_LOG_LEVEL=INFO

# Postgres — the compose file uses the same default.
TALLY_PG_HOST=localhost
TALLY_PG_PORT=5439
TALLY_PG_USER=tally
TALLY_PG_PASSWORD=tally_local_dev
TALLY_PG_DB=tally

# Redpanda
TALLY_KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Redis
TALLY_REDIS_HOST=localhost
TALLY_REDIS_PORT=6389
